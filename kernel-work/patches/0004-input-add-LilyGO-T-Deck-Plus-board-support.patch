 arch/xtensa/boot/dts/esp32s3-t-deck-plus.dts  | 282 ++++++++++++++++++
 drivers/input/keyboard/Kconfig                |  10 +
 drivers/input/keyboard/Makefile               |   1 +
 drivers/input/keyboard/tdeck-keyboard.c       | 254 ++++++++++++++++
 5 files changed, 593 insertions(+)
